@{
    Layout = "~/Views/Shared/_Layout-Admin.cshtml";
    ViewBag.Title = "关于项目";
    ViewBag.PageTitle = "关于项目";
    ViewBag.PageSub = "LX 优选商城 · 技术栈与实现说明";

    var adminCount = (int)(ViewBag.AdminCount ?? 0);
    var memberCount = (int)(ViewBag.MemberCount ?? 0);
    var productCount = (int)(ViewBag.ProductCount ?? 0);
    var orderCount = (int)(ViewBag.OrderCount ?? 0);
    var techs = new[]
    {
        new { T = "ASP.NET MVC 5", D = "控制器 / 视图 / 路由分离，Razor 视图引擎渲染页面" },
        new { T = "Entity Framework 6", D = "Code First 建模 + 自动迁移，Seed 初始化演示数据" },
        new { T = "SQL Server", D = "8 张业务数据表，外键约束与级联规则按业务语义配置" },
        new { T = "Bootstrap 4 + 自研主题", D = "响应式栅格 + LX 设计令牌（配色 / 圆角 / 阴影）" },
        new { T = "jQuery 3 + 原生 JS", D = "AJAX 加购、数量步进、地址选择、提示浮层等交互" },
        new { T = "ECharts 5", D = "后台仪表盘的订单趋势与品类分布可视化" }
    };
    var modules = new[]
    {
        new { T = "会员中心", D = "注册 / 登录 / 邮箱验证、资料与头像维护、收货地址增删、修改密码" },
        new { T = "商品浏览", D = "首页推荐、分类筛选、关键词搜索、多字段排序、分页、商品详情与相关推荐" },
        new { T = "购物车", D = "加购即锁库存、数量增减实时计价、单行移除、一键清空、满 99 免运费" },
        new { T = "订单流程", D = "地址选择 / 新地址下单、订单提交、下单成功页、订单状态跟踪与快递单号" },
        new { T = "后台运营", D = "仪表盘、商品与类别管理、用户管理、订单发货与取消、库存预警" }
    };
}
<div class="lx-about-hero mb-3">
    <div class="lv">@LXIcon.Spark(72)</div>
    <h2>LX 优选商城 · 管理后台</h2>
    <p>
        这是一套完整的电商购物系统，覆盖「浏览 - 加购 - 下单 - 发货 - 收货」的全链路业务，
        并配套后台运营管理能力。项目以 ASP.NET MVC 5 + EF6 为核心，前端全部由自研的 LX 设计系统驱动。
    </p>
    <div class="d-flex flex-wrap mt-3" style="gap:10px;">
        <span class="lx-badge lx-badge-ink">v1.0</span>
        <span class="lx-badge lx-badge-ink">课程实践作品</span>
        <span class="lx-badge lx-badge-ink">仅用于学习交流</span>
    </div>
</div>

<div class="lx-mini-stats mb-3">
    <div class="m">
        <div class="k">管理员账号</div>
        <div class="v">@adminCount</div>
    </div>
    <div class="m">
        <div class="k">注册会员</div>
        <div class="v">@memberCount</div>
    </div>
    <div class="m">
        <div class="k">商品数量</div>
        <div class="v">@productCount</div>
    </div>
    <div class="m">
        <div class="k">订单数量</div>
        <div class="v">@orderCount</div>
    </div>
</div>

<div class="lx-card mb-3">
    <div class="lx-card-head">
        <h3>技术栈</h3>
        <span class="text-muted" style="font-size:12.5px;">.NET Framework 4.6.1</span>
    </div>
    <div class="lx-card-body">
        <div class="lx-tech">
            @foreach (var t in techs)
            {
                <div class="t">
                    <b>@t.T</b>
                    <span>@t.D</span>
                </div>
            }
        </div>
    </div>
</div>

<div class="lx-card mb-3">
    <div class="lx-card-head">
        <h3>功能模块</h3>
    </div>
    <div class="lx-card-body">
        <div class="lx-table-wrap">
            <table class="lx-table">
                <thead>
                    <tr>
                        <th style="width:150px;">模块</th>
                        <th>能力说明</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in modules)
                    {
                        <tr>
                            <td class="strong">@m.T</td>
                            <td>@m.D</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="lx-card">
    <div class="lx-card-head">
        <h3>演示账号与说明</h3>
    </div>
    <div class="lx-card-body">
        <div class="lx-attr" style="grid-template-columns:1fr 1fr;">
            <div class="kv"><span class="k">管理员</span><span class="v">admin / 123456</span></div>
            <div class="kv"><span class="k">管理员</span><span class="v">lxadmin / lx123456</span></div>
            <div class="kv"><span class="k">演示会员</span><span class="v">demo@lx.com / 123456</span></div>
            <div class="kv"><span class="k">演示会员</span><span class="v">vip@lx.com / 123456</span></div>
        </div>
        <p class="text-muted mt-3 mb-0" style="font-size:13px;">
            数据库在首次访问时会自动创建并写入演示数据；如需切换数据库服务器，修改 Web.config 中的
            <b>DefaultConnection</b> 连接字符串即可。
        </p>
        <div class="lx-actions mt-3">
            <a class="lx-btn lx-btn-primary lx-btn-sm" href="@Url.Action("Index", "Home")" target="_blank" rel="noopener">@LXIcon.Eye(15) 打开前台商城</a>
        </div>
    </div>
</div>

@model LXShopping.Models.OrderHeader
@{
    ViewBag.Title = "下单成功";
    var items = Model.OrderDetailItems == null
        ? new List<LXShopping.Models.OrderDetail>()
        : Model.OrderDetailItems.ToList();
    var address = Model.MemberAddress;
}
<div class="lx-crumb">
    <div class="lx-container">
        <a href="@Url.Action("Index", "Home")">首页</a>
        <span class="sep">/</span>
        <span class="now">下单成功</span>
    </div>
</div>

<div class="lx-section">
    <div class="lx-container">
        <div class="lx-steps">
            <span class="step done"><span class="n">1</span> 我的购物车</span>
            <span class="line"></span>
            <span class="step done"><span class="n">2</span> 填写收货信息</span>
            <span class="line"></span>
            <span class="step on"><span class="n">3</span> 下单完成</span>
        </div>

        <div class="lx-card mb-3">
            <div class="lx-card-body">
                <div class="d-flex align-items-center" style="gap:14px;flex-wrap:wrap;">
                    <span class="ico" style="width:52px;height:52px;border-radius:16px;display:flex;align-items:center;justify-content:center;background:var(--lx-ok-soft);color:var(--lx-ok);">
                        @LXIcon.Check(26)
                    </span>
                    <div>
                        <h2 style="font-size:22px;">订单提交成功</h2>
                        <div class="text-muted" style="font-size:13.5px;">
                            订单号 <b>@Model.OrderNo</b> · 下单时间 @Model.BuyOn.ToString("yyyy-MM-dd HH:mm:ss")
                        </div>
                    </div>
                    <div style="margin-left:auto;">
                        <span class="lx-badge @(Model.IsAllShipped ? "lx-badge-ok" : "lx-badge-warn")">@Model.StatusText</span>
                    </div>
                </div>

                <div class="mt-4 d-flex flex-wrap" style="gap:10px;">
                    <a class="lx-btn lx-btn-primary" href="@Url.Action("Index", "AboutMember", new { tab = "orders" })">查看我的订单</a>
                    <a class="lx-btn lx-btn-outline" href="@Url.Action("ProductList", "Home")">继续购物</a>
                </div>
            </div>
        </div>

        <div class="lx-cart-layout">
            <div>
                <div class="lx-card">
                    <div class="lx-card-head">
                        <h3>商品明细 · 共 @Model.TotalQuantity 件</h3>
                    </div>
                    <div class="lx-card-body">
                        @foreach (var d in items)
                        {
                            var pname = string.IsNullOrEmpty(d.ProductName)
                                ? (d.Product == null ? "商品" : d.Product.Name)
                                : d.ProductName;
                            <div class="lx-line" style="box-shadow:none;">
                                <a class="thumb" href="@Url.Action("ProductDetail", "Home", new { id = d.Product == null ? 0 : d.Product.Id })">
                                    <img src="@Url.Action("GetImage", "Home", new { id = d.Product == null ? 0 : d.Product.Id })" alt="@pname" />
                                </a>
                                <div>
                                    <a class="name" href="@Url.Action("ProductDetail", "Home", new { id = d.Product == null ? 0 : d.Product.Id })">@pname</a>
                                    <div class="meta">@LXHelper.Money(d.UnitPrice) × @d.Amount</div>
                                    @if (d.IsShipped)
                                    {
                                        <div class="meta">快递单号：<b>@d.Shipmentnumber</b></div>
                                    }
                                    else
                                    {
                                        <div class="meta">尚未发货，仓库正在打包中</div>
                                    }
                                </div>
                                <div class="actions">
                                    <span class="lx-badge @(d.IsShipped ? "lx-badge-ok" : "lx-badge-warn")">
                                        @(d.IsShipped ? "已发货" : "待发货")
                                    </span>
                                    <span class="lx-price lx-price-sm">@LXHelper.Money(d.Price)</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <aside>
                <div class="lx-card mb-3">
                    <div class="lx-card-head">
                        <h3>收货信息</h3>
                    </div>
                    <div class="lx-card-body">
                        @if (address != null)
                        {
                            <div class="lx-summary-row">
                                <span>收件人</span>
                                <span class="v">@address.ContactName</span>
                            </div>
                            <div class="lx-summary-row">
                                <span>联系电话</span>
                                <span class="v">@address.ContactPhoneNo</span>
                            </div>
                            <div class="lx-summary-row">
                                <span>收货地址</span>
                                <span class="v" style="text-align:right;max-width:180px;">@address.ContactAddress</span>
                            </div>
                        }
                        <div class="lx-summary-row">
                            <span>支付方式</span>
                            <span class="v">@(string.IsNullOrEmpty(Model.PayMethod) ? "在线支付" : Model.PayMethod)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Memo))
                        {
                            <div class="lx-summary-row">
                                <span>订单备注</span>
                                <span class="v" style="text-align:right;max-width:180px;">@Model.Memo</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="lx-card">
                    <div class="lx-card-body">
                        <div class="lx-summary-row">
                            <span>商品件数</span>
                            <span class="v">@Model.TotalQuantity 件</span>
                        </div>
                        <div class="lx-summary-row total">
                            <span>订单金额</span>
                            <span class="v">@LXHelper.Money(Model.TotalPrice)</span>
                        </div>
                        <div class="lx-help mt-3">
                            商品将在 48 小时内发出，发货后可在「个人中心 - 我的订单」查看快递单号。
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

@model LXShopping.Models.ProductDetailViewModel
@{
    var p = Model.Product;
    ViewBag.Title = p.Name;
    var category = p.ProductCategory;
    var soldOut = p.Amount <= 0;
    var hasDeal = p.OriginalPrice.HasValue && p.OriginalPrice.Value > p.Price;
    var cut = hasDeal ? (int)Math.Round((1 - p.Price / p.OriginalPrice.Value) * 100) : 0;
    var maxBuy = p.Amount > 99 ? 99 : p.Amount;
    if (maxBuy < 1) { maxBuy = 1; }
    var imageUrl = Url.Action("GetImage", "Home", new { id = p.Id });
    var related = Model.Related ?? new List<LXShopping.Models.Product>();
}

<div class="lx-crumb">
    <div class="lx-container">
        <a href="@Url.Action("Index", "Home")">首页</a>
        <span class="sep">/</span>
        <a href="@Url.Action("ProductList", "Home")">全部商品</a>
        @if (category != null)
        {
            <span class="sep">/</span>
            <a href="@Url.Action("ProductList", "Home", new { id = category.Id })">@category.Name</a>
        }
        <span class="sep">/</span>
        <span class="now">@p.Name</span>
    </div>
</div>

<div class="lx-section">
    <div class="lx-container">
        <div class="lx-detail" data-buy-area>
            <!-- 左边是商品大图和下面的缩略图 -->
            <div class="lx-gallery">
                <div class="stage">
                    <img src="@imageUrl" alt="@p.Name" />
                </div>
                <div class="d-flex align-items-center mt-3" style="gap:8px;">
                    @if (soldOut)
                    {
                        <span class="lx-badge lx-badge-grey">已售罄</span>
                    }
                    else
                    {
                        <span class="lx-badge lx-badge-ok">现货在售</span>
                    }
                    @if (hasDeal && cut > 0)
                    {
                        <span class="lx-badge lx-badge-sale">立减 @cut%</span>
                    }
                    @if (p.Sales >= 500)
                    {
                        <span class="lx-badge lx-badge-teal">热销爆款</span>
                    }
                    <span class="lx-sold">累计售出 @p.Sales 件</span>
                </div>
            </div>

            <!-- 右边是商品信息、价格、规格和加购按钮 -->
            <div>
                <h1 class="lx-detail-title">@p.Name</h1>

                <div class="lx-detail-meta">
                    @if (category != null)
                    {
                        <span>@LXIcon.Tag(15) @category.Name</span>
                    }
                    <span>@LXIcon.Box(15) @p.Made</span>
                    @if (p.PublishOn.HasValue)
                    {
                        <span>@LXIcon.Refresh(15) @p.PublishOn.Value.ToString("yyyy-MM-dd") 上架</span>
                    }
                </div>

                <div class="lx-price-panel">
                    <div>
                        <span class="lx-price lx-price-lg"><small>¥</small>@p.Price.ToString("N2")</span>
                        @if (hasDeal)
                        {
                            <span class="lx-price-old">¥@p.OriginalPrice.Value.ToString("N2")</span>
                        }
                    </div>
                    <div class="item">库存<b>@p.Amount 件</b></div>
                    <div class="item">累计销量<b>@p.Sales 件</b></div>
                    <div class="item">发货<b>48 小时内</b></div>
                </div>

                <div class="lx-attr">
                    <div class="kv"><span class="k">商品名称</span><span class="v">@p.Name</span></div>
                    <div class="kv"><span class="k">商品类别</span><span class="v">@(category == null ? "—" : category.Name)</span></div>
                    <div class="kv"><span class="k">制造商</span><span class="v">@p.Made</span></div>
                    <div class="kv"><span class="k">商品编号</span><span class="v">LX-@p.Id.ToString("D5")</span></div>
                </div>

                <p class="text-muted">@p.Description</p>

                <div class="lx-buy-bar">
                    @if (soldOut)
                    {
                        <span class="lx-qty">
                            <button type="button" disabled>−</button>
                            <input type="text" value="0" readonly />
                            <button type="button" disabled>+</button>
                        </span>
                        <button class="lx-btn lx-btn-primary lx-btn-lg" type="button" disabled>已售罄</button>
                    }
                    else
                    {
                        <span class="lx-qty" data-qty data-min="1" data-max="@maxBuy">
                            <button class="minus" type="button" aria-label="减少">@LXIcon.Minus(16)</button>
                            <input type="text" value="1" inputmode="numeric" aria-label="购买数量" />
                            <button class="plus" type="button" aria-label="增加">@LXIcon.Plus(16)</button>
                        </span>
                        <button class="lx-btn lx-btn-primary lx-btn-lg" type="button" data-add-cart="@p.Id">
                            @LXIcon.Cart(18) 加入购物车
                        </button>
                        <button class="lx-btn lx-btn-sale lx-btn-lg" type="button"
                                data-add-cart="@p.Id" data-cart-redirect="@Url.Action("Index", "Cart")">
                            立即购买
                        </button>
                    }
                    <a class="lx-btn lx-btn-outline lx-btn-lg" href="@Url.Action("ProductList", "Home", new { id = category == null ? (int?)null : category.Id })">继续逛逛</a>
                </div>

                <div class="mt-3 text-muted" style="font-size:12.5px;">
                    同一商品单次最多购买 99 件 · 满 99 元免运费 · 7 天无理由退换
                </div>
            </div>
        </div>

        <!-- 下面这块是切来切去的详情、参数 -->
        <div class="lx-card mt-5">
            <div class="px-4 pt-3">
                <nav class="lx-tabs" role="tablist">
                    <a class="active" id="tab-desc" data-toggle="tab" href="#pane-desc" role="tab">商品详情</a>
                    <a id="tab-spec" data-toggle="tab" href="#pane-spec" role="tab">规格参数</a>
                    <a id="tab-service" data-toggle="tab" href="#pane-service" role="tab">售后与服务</a>
                </nav>
            </div>
            <div class="lx-card-body tab-content">
                <div class="tab-pane fade show active" id="pane-desc" role="tabpanel">
                    <h3 class="mb-2">@p.Name</h3>
                    <p class="text-muted">@p.Description</p>
                    <p class="text-muted mb-0">
                        本商品由 @p.Made 生产制造，通过 LX 优选商城官方渠道销售。所有在售商品均经过入库质检，
                        如收到商品存在外观破损或功能异常，可在签收后 7 天内申请退换。
                    </p>
                </div>
                <div class="tab-pane fade" id="pane-spec" role="tabpanel">
                    <div class="lx-attr">
                        <div class="kv"><span class="k">商品编号</span><span class="v">LX-@p.Id.ToString("D5")</span></div>
                        <div class="kv"><span class="k">商品类别</span><span class="v">@(category == null ? "—" : category.Name)</span></div>
                        <div class="kv"><span class="k">制造商</span><span class="v">@p.Made</span></div>
                        <div class="kv"><span class="k">商品售价</span><span class="v">@LXHelper.Money(p.Price)</span></div>
                        <div class="kv"><span class="k">市场原价</span><span class="v">@(hasDeal ? LXHelper.Money(p.OriginalPrice.Value) : "—")</span></div>
                        <div class="kv"><span class="k">当前库存</span><span class="v">@p.Amount 件</span></div>
                        <div class="kv"><span class="k">累计销量</span><span class="v">@p.Sales 件</span></div>
                        <div class="kv"><span class="k">上架时间</span><span class="v">@(p.PublishOn.HasValue ? p.PublishOn.Value.ToString("yyyy-MM-dd HH:mm") : "—")</span></div>
                    </div>
                </div>
                <div class="tab-pane fade" id="pane-service" role="tabpanel">
                    <ul class="lx-timeline">
                        <li class="done">下单支付成功后，系统立即为您锁定库存</li>
                        <li class="done">48 小时内仓库完成打包并交由快递发出</li>
                        <li class="done">发货后可在「个人中心 - 我的订单」查看快递单号</li>
                        <li class="on">签收后 7 天内支持无理由退换（商品需保持完好）</li>
                    </ul>
                    <p class="text-muted mb-0">如需帮助，可拨打客服热线 023-6288 8999（09:00 - 21:00）。</p>
                </div>
            </div>
        </div>

        <!-- 相关推荐，推同分类里卖得好的 -->
        @if (related.Any())
        {
            <div class="lx-section-head mt-5">
                <div>
                    <h2 class="lx-section-title"><span class="bar"></span>相关推荐</h2>
                    <div class="lx-section-sub">同类目下的其他好物</div>
                </div>
            </div>
            <div class="lx-grid lx-grid-4">
                @foreach (var item in related)
                {
                    @Html.Partial("_ProductCard", item)
                }
            </div>
        }
    </div>
</div>
